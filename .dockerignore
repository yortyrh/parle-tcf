# Dependencies (installed fresh inside Docker). `**/` also matches nested packages: a bare
# pattern only matches at the context root.
**/node_modules

# Build artifacts (rebuilt inside Docker)
**/.next
**/.next-dev
**/.next-e2e
**/dist
**/.turbo

# Git
.git

# Environment (injected via Railway / docker-compose env vars)
**/.env
**/.env.*
!**/.env.example

# Secrets
**/*.pem

# OS
**/.DS_Store
Thumbs.db

# IDE / editor
.cursor
.claude
.idea
.vscode
*.swp
*.swo

# TypeScript incremental cache
**/*.tsbuildinfo

# Test output
**/coverage
**/reports
**/playwright-report
**/test-results

# CI / docs not needed at build time
.github
