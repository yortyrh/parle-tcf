{
  "name": "parle-tcf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm lint:root",
    "lint:root": "eslint scripts \"*.mjs\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check . --log-level warn",
    "prepare": "if [ -e .git ]; then lefthook install; fi",
    "lint:fix": "turbo run lint -- --fix",
    "test:scripts": "vitest run --config vitest.config.mjs",
    "verify": "node scripts/check-node-version.mjs && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:scripts && pnpm build && pnpm env-schema:check",
    "test:coverage": "turbo run test:coverage --concurrency=2",
    "env-schema:check": "node scripts/check-env-schema.mjs",
    "mutate": "node scripts/mutate.mjs",
    "mutate:full": "node scripts/mutate.mjs --full",
    "test:e2e": "pnpm --filter @parle-tcf/e2e test:e2e",
    "test:integration": "pnpm --filter @parle-tcf/api... build && pnpm --filter @parle-tcf/api test:integration",
    "push": "node scripts/push.mjs",
    "db:generate": "pnpm --filter @parle-tcf/db db:generate",
    "db:migrate": "pnpm --filter @parle-tcf/db build && pnpm --filter @parle-tcf/db db:migrate",
    "scaffold:api-feature": "node scripts/scaffold.mjs api-feature",
    "scaffold:web-page": "node scripts/scaffold.mjs web-page",
    "scaffold:package": "node scripts/scaffold.mjs package",
    "scaffold:smoke": "node scripts/scaffold.mjs smoke",
    "db:generate:custom": "pnpm --filter @parle-tcf/db exec drizzle-kit generate --custom --name",
    "infra:up": "bash scripts/compose.sh up -d --wait && pnpm --filter @parle-tcf/db build && node --env-file-if-exists=apps/api/.env scripts/infra-init.mjs",
    "infra:down": "bash scripts/compose.sh down",
    "infra:reset": "bash scripts/compose.sh down --volumes",
    "infra:logs": "bash scripts/compose.sh logs -f",
    "setup:env": "node scripts/setup-local-env.mjs",
    "samples:seed": "pnpm --filter @parle-tcf/db build && node scripts/seed-dev-users.mjs",
    "local:credentials": "node scripts/show-local-credentials.mjs",
    "exercises:seed-sql": "pnpm --filter @parle-tcf/db build && node scripts/exercises-csv-to-sql.mjs",
    "exercises:import": "pnpm --filter @parle-tcf/importer... build && node --env-file-if-exists=apps/api/.env packages/importer/dist/cli.js",
    "deploy:railway": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "15.5.29",
    "@parle-tcf/db": "workspace:*",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "better-auth": "^1.7.20",
    "csv-parse": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "license": "MIT"
}
