{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/importer/Dockerfile",
    "watchPatterns": [
      "packages/importer/**",
      "packages/db/**",
      "pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "cronSchedule": "0 6 * * 1",
    "restartPolicyType": "NEVER"
  }
}
