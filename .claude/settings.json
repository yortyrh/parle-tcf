{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(pnpm lint:*)",
      "Bash(pnpm lint:fix:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm verify:*)",
      "Bash(pnpm scaffold:*)",
      "Bash(pnpm db:generate:*)",
      "Bash(pnpm --filter * test:*)",
      "Bash(pnpm --filter * typecheck:*)",
      "Bash(pnpm --filter * lint:*)"
    ],
    "deny": ["Bash(git push:*)", "Bash(git commit --no-verify:*)"]
  }
}
