# Used by docker-compose (see apps/api/.env.example and apps/web/.env.example for per-app details).
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# v1:<base64 of 32 random bytes> (openssl rand -base64 32)
ENCRYPTION_KEYS=

# Usage limits per user (overridable per row in usage_limits)
DEFAULT_DAILY_MINUTES=60
DEFAULT_MONTHLY_COST_USD=10

# Optional: fills the exercise bank from the private repository (else the sample bank).
# EXERCISE_DATA_TOKEN=
