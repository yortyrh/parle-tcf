# OpenAI — required for POST /v1/realtime/client_secrets
OPENAI_API_KEY=

# When service.yml sets llm.model to "realtime", this overrides the concrete model id (optional).
# OPENAI_REALTIME_MODEL=gpt-realtime-mini

# HTTP port (Railway sets PORT automatically)
PORT=3001

# Comma-separated browser origins for CORS (empty = allow all)
CORS_ORIGINS=http://localhost:3000
