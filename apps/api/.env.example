# --- Database (docker compose up -d postgres) ---
DATABASE_URL=postgresql://parle:parle@127.0.0.1:5432/parle

# --- Better Auth ---
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this API (OAuth callbacks are ${BETTER_AUTH_URL}/api/auth/callback/<provider>)
BETTER_AUTH_URL=http://localhost:3001
# Public URL of the web app (email links land there)
WEB_URL=http://localhost:3000
# Set to false to let people sign in without confirming their email (local dev only)
AUTH_EMAIL_VERIFICATION_ENABLED=true
# Optional OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Encryption of users' provider API keys (AES-256-GCM) ---
# One or more "<version>:<base64 of 32 random bytes>" entries: openssl rand -base64 32
# Rotate by adding v2, switching ENCRYPTION_KEY_CURRENT, then: pnpm --filter @parle-tcf/api rotate-keys
ENCRYPTION_KEYS=v1:
ENCRYPTION_KEY_CURRENT=v1

# --- Mail: RESEND_API_KEY (HTTPS, for hosts that block SMTP) > SMTP_URL > log only ---
# Production refuses to start with neither. `pnpm setup:env` writes the local values.
# RESEND_API_KEY=
# Mailpit from docker compose: smtp://127.0.0.1:1025 (inbox on http://localhost:8025)
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="parle-tcf <no-reply@localhost>"

# --- HTTP ---
PORT=3001
# Comma-separated browser origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000

# Optional: overrides the model when service.yml sets llm.model to "realtime"
# OPENAI_REALTIME_MODEL=gpt-realtime-mini

# Usage limits per user (overridable per row in usage_limits)
DEFAULT_DAILY_MINUTES=60
DEFAULT_MONTHLY_COST_USD=10

# Optional: S3-compatible storage (R2, MinIO, S3) for attempt recordings. Unset = audio disabled.
# The browser uploads with a presigned POST (size-capped): the bucket CORS must allow POST
# from the web origin, and GET for playback. Locally, `pnpm setup:env` points these at the
# RustFS service of docker-compose.dev.yml and `pnpm infra:up` creates the bucket and CORS.
# S3_BUCKET=parle-tcf-audio
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Tests only: `fake` replaces OpenAI/Gemini (voice and corrector) with local stand-ins. Refused in production.
# VOICE_PROVIDER=real
# Requests per minute per client before HTTP 429.
# THROTTLE_LIMIT_PER_MINUTE=120
