# Generated locally by `pnpm setup:env` into apps/web/.env.local.
# Base URL of the NestJS API, as seen by the browser. Inlined at build time (Dockerfile ARG / Railway).
NEXT_PUBLIC_EXAM_API_URL=http://localhost:3001
# Show the social sign-in buttons (the API must have GITHUB_* / GOOGLE_* credentials).
NEXT_PUBLIC_AUTH_GITHUB_OAUTH_ENABLED=false
NEXT_PUBLIC_AUTH_GOOGLE_OAUTH_ENABLED=false
# Local only: Mailpit inbox linked from the auth pages in development.
NEXT_PUBLIC_MAILPIT_URL=http://localhost:8025
