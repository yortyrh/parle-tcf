{
  "name": "@yorty-tcf/agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate-db": "tsx scripts/csv-to-sqlite.ts",
    "build": "tsx scripts/csv-to-sqlite.ts && tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{ts,js}\"",
    "lint:fix": "eslint --fix \"**/*.{ts,js}\"",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "tsx scripts/run-unit-tests.ts",
    "test:watch": "tsx scripts/run-unit-tests.ts --watch",
    "dev": "tsx src/agent.ts dev",
    "download-files": "pnpm run build && node dist/agent.js download-files",
    "start": "node dist/agent.js start",
    "extract-tef": "tsx scripts/extract-tef-exercises.ts",
    "generate-tef-images": "tsx scripts/generate-tef-images.ts",
    "generate-tef-annonces": "tsx scripts/generate-tef-annonces.ts",
    "clean-tef-dimension-images": "tsx scripts/clean-tef-dimension-images.ts",
    "reset-tef-images": "tsx scripts/reset-tef-images.ts"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.11",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "dependencies": {
    "@yorty-tcf/shared": "workspace:*",
    "@google/genai": "^1.3.0",
    "@livekit/agents": "1.0.27",
    "@livekit/agents-plugin-google": "1.0.30",
    "@livekit/agents-plugin-livekit": "1.0.27",
    "@livekit/agents-plugin-openai": "1.0.27",
    "@livekit/agents-plugin-silero": "1.0.27",
    "@livekit/noise-cancellation-node": "^0.1.9",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.2.3",
    "openai": "^6.25.0",
    "yaml": "^2.8.2",
    "zod": "^3.25.76"
  }
}
