{
  "name": "yorty-tcf-livekit-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{ts,js}\"",
    "lint:fix": "eslint --fix \"**/*.{ts,js}\"",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "node --test --import tsx",
    "test:watch": "node --test --watch --import tsx",
    "dev": "tsx src/agent.ts dev",
    "download-files": "pnpm run build && node dist/agent.js download-files",
    "start": "node dist/agent.js start",
    "extract-tef": "tsx scripts/extract-tef-exercises.ts",
    "generate-tef-images": "tsx scripts/generate-tef-images.ts",
    "reset-tef-images": "tsx scripts/reset-tef-images.ts"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.18.11",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "dependencies": {
    "@livekit/agents": "^1.0.21",
    "@livekit/agents-plugin-google": "~1.0.30",
    "@livekit/agents-plugin-livekit": "^1.0.21",
    "@livekit/agents-plugin-openai": "^1.0.27",
    "@livekit/agents-plugin-silero": "^1.0.21",
    "@livekit/noise-cancellation-node": "^0.1.9",
    "@google/genai": "^1.3.0",
    "dotenv": "^17.2.3",
    "openai": "^6.25.0",
    "yaml": "^2.8.2",
    "zod": "^3.25.76"
  }
}
